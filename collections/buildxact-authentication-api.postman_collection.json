          "name": "Login and Obtain Bearer Token",
          "request": {
            "name": "Login and Obtain Bearer Token",
            "description": {
              "content": "Exchange a Buildxact user email and plaintext API key for a short-lived bearer token plus refresh token. The subscription key header is still required to route the request through API Management.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Ocp-Apim-Subscription-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"apiKey\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
